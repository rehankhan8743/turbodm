package com.turbodm.app.data.local

// DownloadDaoTest.kt.disabled
//
// Disabled because Robolectric's native runtime (librobolectric-nativeruntime.so)
// is only published for x86_64 Linux, and Termux is aarch64. The artifact
// `org.robolectric:nativeruntime-dist-compat` only ships:
//
//   native/linux/x86_64/librobolectric-nativeruntime.so
//   native/mac/aarch64/librobolectric-nativeruntime.dylib
//
// No aarch64 Linux .so exists, so ShadowNativeSQLiteConnection fails with
// "The Robolectric native runtime is not supported on Linux (aarch64)".
//
// To run this test:
//   1. On an x86_64 dev machine, run the org.robolectric + androidx.test.ext.junit
//      deps and rename this file back to .kt.
//   2. On any architecture, run as an instrumented test under
//      androidTest/ with a real Android emulator/device.

// [original test code follows below — kept for reference]
